<mvc:View controllerName="graphicalplanning.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:mc="sap.suite.ui.microchart">
    <Page id="page" title="BTP Custom Maintenance Planner">
        <content>
            <VBox class="sapUiSmallMargin">
                
<Panel headerText="Panel de Rendimiento Global" expandable="true" expanded="true" class="sapUiMediumMarginBottom AreaBackground">
    <FlexBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Start" backgroundDesign="Solid" class="sapUiSmallMargin sapUiAreaForegroundStretched">
        <items>
            
            <VBox class="sapUiNoContentPadding" width="31%" style="border-right: 1px solid #d9d9d9; padding-right: 1.5rem;">
                <VBox style="background-color: #ebeef0; border-radius: 4px; padding: 0.5rem 0.8rem;" class="sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://manager" class="sapUiTinyMarginEnd" color="Default" size="1.1rem" />
                            <Title text="Supervisores" level="H5" titleStyle="H5" />
                        </HBox>
                        <ObjectStatus text="{= ${plan>/summary/supervisors}.length } Activos" state="None" />
                    </HBox>
                </VBox>

                <ScrollContainer height="280px" vertical="true" horizontal="false" class="sapUiNoContentPadding">
                    <mc:ComparisonMicroChart id="supervisorChart" size="Responsive" width="100%" 
                        isAllowedToOverflow="true" data="{plan>/summary/supervisors}" press="onChartPress" minValue="0" maxValue="100">
                        <mc:data>
                            <mc:ComparisonMicroChartData title="{plan>Title}" value="{plan>Value}" displayValue="{plan>Value}%" color="{plan>Color}"/>
                        </mc:data>
                    </mc:ComparisonMicroChart>
                </ScrollContainer>
            </VBox>

            <VBox class="sapUiNoContentPadding" width="31%" style="border-right: 1px solid #d9d9d9; padding-right: 1.5rem; margin-left: 1rem;">
                <VBox style="background-color: #ebeef0; border-radius: 4px; padding: 0.5rem 0.8rem;" class="sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://wrench" class="sapUiTinyMarginEnd" color="Default" size="1.1rem" />
                            <Title text="Mecánicos" level="H5" titleStyle="H5" />
                        </HBox>
                        <ObjectStatus text="{= ${plan>/summary/mecanicos}.length } Técnicos" state="None" />
                    </HBox>
                </VBox>

                <ScrollContainer height="280px" vertical="true" horizontal="false" class="sapUiNoContentPadding">
                    <mc:ComparisonMicroChart id="mecanicosChart" size="Responsive" width="100%" 
                        isAllowedToOverflow="true" data="{plan>/summary/mecanicos}" press="onChartPress" minValue="0" maxValue="100">
                        <mc:data>
                            <mc:ComparisonMicroChartData title="{plan>Title}" value="{plan>Value}" displayValue="{plan>Value}%" color="{plan>Color}"/>
                        </mc:data>
                    </mc:ComparisonMicroChart>
                </ScrollContainer>
            </VBox>

            <VBox class="sapUiNoContentPadding" width="31%" style="margin-left: 1rem;">
                <VBox style="background-color: #ebeef0; border-radius: 4px; padding: 0.5rem 0.8rem;" class="sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://map-2" class="sapUiTinyMarginEnd" color="Default" size="1.1rem" />
                            <Title text="Zonas" level="H5" titleStyle="H5" />
                        </HBox>
                        <ObjectStatus text="{= ${plan>/summary/zonas}.length } Áreas" state="None" />
                    </HBox>
                </VBox>

                <ScrollContainer height="280px" vertical="true" horizontal="false" class="sapUiNoContentPadding">
                    <mc:ComparisonMicroChart id="zonasChart" size="Responsive" width="100%" 
                        isAllowedToOverflow="true" data="{plan>/summary/zonas}" press="onChartPress" minValue="0" maxValue="100">
                        <mc:data>
                            <mc:ComparisonMicroChartData title="{plan>Title}" value="{plan>Value}" displayValue="{plan>Value}%" color="{plan>Color}"/>
                        </mc:data>
                    </mc:ComparisonMicroChart>
                </ScrollContainer>
            </VBox>

        </items>
    </FlexBox>
</Panel>
                <Title text="Cronograma de Órdenes" level="H2" class="sapUiMediumMarginBottom" />
                
                <OverflowToolbar class="sapUiTinyMarginBottom">
                    <Label text="Periodo de Planificación:" />
                    <DateRangeSelection id="rangeSelection" width="250px" change="._loadDashboardData" displayFormat="dd/MM/yyyy"/>
                    
                    <ToolbarSeparator />
                    
                    <SearchField 
                        id="searchOrders" 
                        placeholder="Buscar orden, equipo o cliente..." 
                        width="300px" 
                        liveChange=".onSearchGantt" />

                    <ToolbarSpacer />
                    
                    <Button id="btnSave" icon="sap-icon://save" text="Guardar Cambios" type="Accept" enabled="false" press=".onSaveSAP" class="sapUiTinyMarginEnd"/>
                    <Button id="btnReset" icon="sap-icon://reset" text="Descartar Cambios" type="Transparent" enabled="false" press=".onResetChanges" />
                    <Button icon="sap-icon://refresh" text="Recargar" press="._loadDashboardData" type="Emphasized"/>
                    <Button 
                        icon="sap-icon://excel-attachment" 
                        text="Exportar Excel" 
                        press=".onExportExcel" 
                        type="Default" />
                    <ToolbarSeparator />
                    <Button 
                        icon="sap-icon://expand-group" 
                        text="Expandir Todo"
                        tooltip="Mostrar órdenes " 
                        press=".onExpandAll" 
                        type="Transparent" />
                    <Button 
                        icon="sap-icon://collapse-group" 
                        text="Colapsar Todo"
                        tooltip="Ocultar órdenes" 
                        press=".onCollapseAll" 
                        type="Transparent" />
                    <ToolbarSeparator />
                </OverflowToolbar>

                <HBox class="gantt-legend sapUiSmallMarginBottom" wrap="Wrap" justifyContent="Start" alignItems="Center">
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u100"&gt;{plan>/summary/u100}&lt;/div&gt;' />
                        <Text text="Orden Pendiente" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u200"&gt;{plan>/summary/u200}&lt;/div&gt;' />
                        <Text text="Orden En proceso" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u300"&gt;{plan>/summary/u300}&lt;/div&gt;' />
                        <Text text="Orden Finalizada" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u400"&gt;{plan>/summary/u400}&lt;/div&gt;' />
                        <Text text="Orden Pendiente de firma" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-abie" style="font-size:12px; color:#b9770e;"&gt;⚠️ {plan>/summary/abie}&lt;/div&gt;' />
                        <Text text="Orden Planificada SAP" class="sapUiTinyMarginBegin" />
                    </HBox>

                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-default"&gt;{plan>/summary/others}&lt;/div&gt;' />
                        <Text text="Orden Liberada SAP Y BTP" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item">
                        <core:HTML content='&lt;div class="legend-box order-changed" style="background:#666; color:white; font-size:10px; font-weight:bold; display:flex; justify-content:center; align-items:center;"&gt;{plan>/summary/changed}&lt;/div&gt;' />
                        <Text text="Cambio sin guardar" class="sapUiTinyMarginBegin" />
                    </HBox>
                </HBox>

                <ScrollContainer busy="{plan>/isBusy}" width="100%" height="900px" horizontal="true" vertical="true">
                    <core:HTML id="myGanttHtml" preferDOM="true"
                        content='&lt;div id="gantt-container-scroll" style="width: 3720px;"&gt;
                                    &lt;div id="ganttHeader" class="gantt-header"&gt;&lt;/div&gt;
                                    &lt;div id="realGanttId" class="gantt-master-container"&gt;&lt;/div&gt;
                                 &lt;/div&gt;'>
                    </core:HTML>
                </ScrollContainer>
            </VBox>
        </content>
    </Page>
</mvc:View>