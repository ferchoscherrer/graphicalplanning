<mvc:View controllerName="graphicalplanning.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" xmlns:core="sap.ui.core">
    <Page id="page" title="BTP Custom Maintenance Planner">
        <content>
            <VBox class="sapUiSmallMargin">
                <Title text="Cronograma de Órdenes (TypeScript Native)" level="H2" class="sapUiMediumMarginBottom" />
                
                <OverflowToolbar class="sapUiTinyMarginBottom">
    <Label text="Periodo de Planificación:" />
    <DateRangeSelection id="rangeSelection" width="250px" change="._loadDashboardData" displayFormat="dd/MM/yyyy"/>
    
    <ToolbarSeparator />
    
    <SearchField 
        id="searchOrders" 
        placeholder="Buscar orden, equipo o cliente..." 
        width="300px" 
        liveChange=".onSearchGantt" />

    <ToolbarSpacer />
    
    <Button id="btnSave" icon="sap-icon://save" text="Guardar Cambios" type="Accept" enabled="false" press=".onSaveSAP" class="sapUiTinyMarginEnd"/>
    <Button id="btnReset" icon="sap-icon://reset" text="Descartar Cambios" type="Transparent" enabled="false" press=".onResetChanges" />
    <Button icon="sap-icon://refresh" text="Recargar" press="._loadDashboardData" type="Emphasized"/>
</OverflowToolbar>

                <HBox class="gantt-legend sapUiSmallMarginBottom" wrap="Wrap" justifyContent="Start" alignItems="Center">
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u100"&gt;&lt;/div&gt;' />
                        <Text text="Pendiente (100)" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u200"&gt;&lt;/div&gt;' />
                        <Text text="En Proceso (200)" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u300"&gt;&lt;/div&gt;' />
                        <Text text="Finalizada (300)" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-u400"&gt;&lt;/div&gt;' />
                        <Text text="Pte. Firma (400)" class="sapUiTinyMarginBegin" />
                    </HBox>
                    
                    <HBox alignItems="Center" class="legend-item sapUiSmallMarginEnd">
                        <core:HTML content='&lt;div class="legend-box status-abie" style="display:flex; justify-content:center; align-items:center; font-size:10px;"&gt;⚠️&lt;/div&gt;' />
                        <Text text="Abierta (ABIE)" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox alignItems="Center" class="legend-item">
                        <core:HTML content='&lt;div class="legend-box status-default"&gt;&lt;/div&gt;' />
                        <Text text="Otros" class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox alignItems="Center" class="legend-item">
    <core:HTML content='&lt;div class="legend-box order-changed" style="background:#666;"&gt;&lt;/div&gt;' />
    <Text text="Cambio sin guardar" class="sapUiTinyMarginBegin" />
</HBox>
                </HBox>

                <ScrollContainer busy="{plan>/isBusy}" width="100%" height="600px" horizontal="true" vertical="true">
                    <core:HTML id="myGanttHtml" preferDOM="true"
                        content='&lt;div id="gantt-container-scroll" style="width: 3720px;"&gt;
                                    &lt;div id="ganttHeader" class="gantt-header"&gt;&lt;/div&gt;
                                    &lt;div id="realGanttId" class="gantt-master-container"&gt;&lt;/div&gt;
                                 &lt;/div&gt;'>
                    </core:HTML>
                </ScrollContainer>
            </VBox>
        </content>
    </Page>
</mvc:View>